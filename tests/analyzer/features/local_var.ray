glob := 1
period := "."
loc2 := "sneaky"

fn main() {
    {
        loc1 := 1.5
        loc2 := 5
        _loc3 := -.5

        print _loc3 + loc1

        {
            loc1 := 6.
            loc2 := 1.5

            print loc2 + loc1
            print loc1 + _loc3
        }

        print loc2
    }

    {
        loc1 := "local"
        loc2 := " var"

        print loc1 + loc2 + period

        loc2 = "assign local"
        {
            loc2 := "sublocal"
            loc2 = "assign sub"
        }
        loc2 = loc1
    }

    loc2 = "still glob"
}

