fn main() {
    a: int|bool
    b: bool|int = 1
    b = true
    a = b

    // In array
    arr := [1, true]
    arr[0] = false
    arr[0] = 1

    arr2: [](str|float) = [4.5, 6.7, "yep"]
    arr2[0] = "maybe"
    arr2[0] = 6.9

    // In optional
    opt: ?int|float = 3
    opt = 6.7
    opt = null
    opt = 1

    optUnion: ?int|float = 6
    optInt: ?int = 7
    optUnion = optInt

    // Arrays
    arr3: [](int|bool) = [1, true]
    arr4: []int|bool = [1]
    arr4 = false
}

