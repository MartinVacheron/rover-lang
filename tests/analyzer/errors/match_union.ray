union Marker {
    cross,
    circle,
    none
}

union Bar{a}

fn getMarker() -> Marker {
    return .cross
}

fn main() {
    marker: Marker = .cross
    bar: Bar = .a

    match marker {
        Marker.circle => print "circle"
        Marker.cross => print "cross"
    }

    match marker {
        .circle => print "circle"
        .none => print "none"
    }

    foo := match marker {
        Bar.a => 65
        .circle => 1
        .cross => 2
        .none => {
            tmp := 4
            tmp2 := 6
            break 3
        }
    }

    match marker {
        .circle => {}
        .circle => {}
    }

    match marker {
        .circle => {}
        getMarker() => {}
    }

    match marker {
        .circle => {}
        .cross => {}
        .none => {}
        else => {}
    }
}

