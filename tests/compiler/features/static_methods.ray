struct Vec1 {
    x: int

    fn new(x: int) -> Vec1 {
        return Vec1 { x }
    }
}

fn main() {
    struct Point { x: int }

    struct Vec2 {
        x: int, y: int,

        fn new(x: int, y: int) -> Self {
            return Vec2 { x, y }
        }
    }

    v := Vec1.new(5)
    new := Vec1.new
    v = new(65)

    v2 := Vec2.new(12, 99)
    new2 := Vec2.new
    v2 = new2(56, 78)
}
