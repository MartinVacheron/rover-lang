struct Vec2 {
    x, y: int,

    fn +(self, other: Self) -> Self {
        return .{
            x=self.x + other.x,
            y=self.y + other.y,
        }
    }

    fn -(self, other: Self) -> Self {
        return .{
            x=self.x - other.x,
            y=self.y - other.y,
        }
    }

    fn *(self, other: Self) -> Self {
        return .{
            x=self.x * other.x,
            y=self.y * other.y,
        }
    }

    fn /(self, other: Self) -> Self {
        return .{
            x=self.x / other.x,
            y=self.y / other.y,
        }
    }
}

fn main() {
    v1 := Vec2{ x=4, y=12 }
    v2 := Vec2{ x=2, y=4 }

    add := v1 + v2
    sub := v1 - v2
    mul := v1 * v2
    div := v1 / v2
}
