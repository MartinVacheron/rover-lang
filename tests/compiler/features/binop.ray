fn main() {
    i := 1
    f := 2.
    s := "foo"

    _ = i + -i
    _ = f + -f
    _ = s + s
    _ = f - -f
    _ = i - -i
    _ = f * -f
    _ = i * -i
    _ = i * s
    _ = s * i
    _ = f / -f
    _ = i / -i
    _ = i > i
    _ = f > f
    _ = f >= f
    _ = i >= i
    _ = f < -f
    _ = i < -i
    _ = i <= i
    _ = f <= f
    _ = i == i
    _ = f == f
    _ = i != i
    _ = f != f
    i % i
    f % f

    a := 1
    b := 2
    *a == *b
    *a != *b

    a & 1
    a | 1
    a ^ 1
    a << 1
    a >> 1
}
