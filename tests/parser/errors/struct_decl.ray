// No name
struct {}

// No comma
struct Foo {
    a: int
    b: float
}

// Fields after methods
struct Foo {
    fn add() {}

    age: int
}

// No type, no default
struct Foo {
    age
}

// No openning brace
struct Foo
    a := 1

// Stuff after methods
struct Foo {
    fn abc() {}

    a := 1
}

// Missing closing brace
struct Foo {
    fn a() {}

